{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "layout": { "contentSize": "720px", "wideSize": "1100px" },
    "color": {
      "palette": [
        { "slug": "base", "name": "Base", "color": "#fffdf8" },
        { "slug": "contrast", "name": "Contrast", "color": "#1f2933" },
        { "slug": "primary", "name": "Primary", "color": "#2f6f5e" },
        { "slug": "accent", "name": "Accent", "color": "#e9a23b" }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "slug": "system",
          "name": "System",
          "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--contrast)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--system)",
      "fontSize": "1.125rem",
      "lineHeight": "1.6"
    }
  }
}